{
  "name": "tokenbar-demo",
  "private": true,
  "description": "Renders the README product demo (docs/assets/demo.gif) from a three.js scene.",
  "scripts": {
    "render": "node render.mjs 20",
    "encode": "ffmpeg -loglevel error -y -framerate 20 -i frames/f%04d.png -vf \"scale=720:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=256:stats_mode=full:reserve_transparent=0[p];[b][p]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle\" -loop 0 ../../docs/assets/demo.gif",
    "build": "npm run render && npm run encode"
  },
  "dependencies": {
    "playwright-core": "1.48.2",
    "three": "0.170.0"
  }
}
