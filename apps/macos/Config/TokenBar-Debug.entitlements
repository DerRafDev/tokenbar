<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug only: the agent prototype selects a Terminal tab with an Apple Event ("Go to Session").
	     The hardened runtime blocks Apple Events without this entitlement. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Debug builds are ad-hoc signed: without this the hardened runtime refuses to load the
	     embedded Sparkle.framework (no Team ID to match). See TokenBar-AdHoc.entitlements. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
