<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ad-hoc signed release builds only (scripts/release.sh without DEVELOPER_ID_IDENTITY).
	     The hardened runtime loads only libraries signed by the app's own Team ID, and an ad-hoc
	     signature has none, so embedded Sparkle.framework would be refused at launch.
	     Developer ID builds sign Sparkle with their own Team ID and do not use this file. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
