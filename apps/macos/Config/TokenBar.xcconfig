// Build settings for the TokenBar app target. Kept here instead of project.pbxproj so
// changes are reviewable.
#include "Version.xcconfig"

PRODUCT_NAME = TokenBar
PRODUCT_BUNDLE_IDENTIFIER = io.github.derrafdev.TokenBar
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0

// Menu-bar-only: no Dock icon, no main window.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_CFBundleDisplayName = TokenBar
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_NSHumanReadableCopyright = © 2026 TokenBar contributors. MIT License.
// Extra keys (Sparkle) that have no INFOPLIST_KEY_ setting. Merged into the generated plist.
INFOPLIST_FILE = Config/Info.plist

// Sparkle in-app updates (docs/releasing.md). The feed is the appcast.xml attached to the
// latest published GitHub Release, so drafts and pre-releases are never offered.
// `/$()/` keeps `//` from starting an xcconfig comment.
SPARKLE_FEED_URL = https:/$()/github.com/DerRafDev/tokenbar/releases/latest/download/appcast.xml
// Public half of the EdDSA key that signs update archives. Not a secret. The private key is
// never in the repository: it lives in the release maintainer's Keychain and in the
// SPARKLE_PRIVATE_KEY Actions secret. scripts/release.sh refuses to run while this is empty.
SPARKLE_PUBLIC_ED_KEY =
// Sparkle.framework is embedded in Contents/Frameworks.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

// App icon: TokenBar/AppIcon.icon (Icon Composer). Xcode also derives the .icns used before
// macOS 26 from it. The original artwork is docs/assets/app-icon.png.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Distributed outside the Mac App Store: hardened runtime (required for notarization),
// no App Sandbox (providers read credentials owned by other apps; see docs/providers.md).
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO

// Local builds are ad-hoc signed so contributors need no Apple Developer account.
// The release workflow overrides these with a Developer ID identity.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
COMBINE_HIDPI_IMAGES = YES

// Debug only: the agent prototype ("Go to Session") selects a Terminal tab with an Apple Event.
// Release builds send no Apple Events and carry neither the entitlement nor the prompt text.
CODE_SIGN_ENTITLEMENTS[config=Debug] = Config/TokenBar-Debug.entitlements
INFOPLIST_KEY_NSAppleEventsUsageDescription[config=Debug] = TokenBar brings the Terminal tab with a waiting Claude Code question to the front. It never types into the session.
