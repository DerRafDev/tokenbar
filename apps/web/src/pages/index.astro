---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="TokenBar — AI usage in your macOS menu bar"
  description="TokenBar is a small native macOS app that shows your Claude and Codex plan usage limits, and when they reset, in the menu bar."
>
  <main>
    <h1>TokenBar</h1>
    <p>Website coming soon.</p>
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    place-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0 16px;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 2.5rem;
  }

  p {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }
</style>
