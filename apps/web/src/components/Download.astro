---
// 10. Download. Brings back the hero's menu bar and the app icon, then the honest install
// steps for an unsigned build (README › Installation). The button links to the latest
// GitHub release, so no version is hardcoded here.
import { Image } from "astro:assets";
import appIcon from "../assets/app-icon.png";
import Icon from "./Icon.astro";
import StatusItem from "./StatusItem.astro";
import { links, requirements } from "../config";
---

<section id="download" class="download" data-download aria-labelledby="download-title">
  <div class="download__glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="download__bar" aria-hidden="true" data-reveal>
      <span class="download__apps"><b>TokenBar</b></span>
      <StatusItem highlighted />
      <span class="download__clock" data-clock-copy>9:41 AM</span>
    </div>

    <div class="download__hero">
      <div class="download__icon" data-download-icon>
        <Image src={appIcon} alt="TokenBar app icon" width={300} height={300} densities={[1, 2]} loading="lazy" />
      </div>
      <h2 id="download-title" class="display download__title" data-lines>
        <span class="line"><span>Keep your limits</span></span>{" "}
        <span class="line"><span class="serif">in sight.</span></span>
      </h2>
      <p class="lede download__lede" data-reveal>Download TokenBar for macOS. Free and open source.</p>
      <div class="actions download__actions" data-reveal style="--d:1">
        <a class="btn" href={links.download} data-magnetic><Icon name="download" />Download for macOS — Free</a>
        <a class="btn btn--ghost" href={links.repo} rel="noopener" data-magnetic><Icon name="github" />GitHub</a>
      </div>
      <p class="platforms download__platforms" data-reveal style="--d:2">
        <span><i class="dot"></i>macOS available now</span>
        <span><i class="dot dot--dev"></i>Windows in development</span>
      </p>
      <p class="download__req" data-reveal style="--d:2">{requirements}</p>
    </div>

    <div class="install" id="install">
      <div class="install__intro" data-reveal>
        <h3>Opening it the first time</h3>
        <p>
          TokenBar is not signed and notarized by Apple yet, so macOS blocks the first launch. That is not a malware
          finding: the build simply hasn’t gone through Apple’s Developer ID process. Open it only if you downloaded it
          from the <a class="link" href={links.releases} rel="noopener">official releases</a>. You approve TokenBar once;
          later launches open normally.
        </p>
      </div>
      <ol class="install__steps" role="list">
        <li data-reveal style="--d:1">
          <span>1</span>
          <p>Download the <code>.dmg</code> from the latest release, open it, and drag TokenBar to Applications.</p>
        </li>
        <li data-reveal style="--d:2">
          <span>2</span>
          <p>Open TokenBar. When macOS says it can’t verify the app, click <strong>Done</strong>.</p>
        </li>
        <li data-reveal style="--d:3">
          <span>3</span>
          <p>
            Go to <strong>System Settings › Privacy &amp; Security</strong>, find the message about TokenBar, click{" "}
            <strong>Open Anyway</strong>, and confirm.
          </p>
        </li>
        <li data-reveal style="--d:4">
          <span>4</span>
          <p>Click TokenBar in the menu bar, choose <strong>Configure Providers…</strong>, and turn on the ones you use.</p>
        </li>
      </ol>
      <p class="install__foot" data-reveal>
        Don’t turn off Gatekeeper for your whole Mac; this approves TokenBar only. Each release lists SHA-256 checksums in{" "}
        <code>SHA256SUMS.txt</code>. Prefer to build it yourself? The <a class="link" href={`${links.repo}#development`} rel="noopener">README</a> has the steps.
      </p>
    </div>
  </div>
</section>

<script>
  import { pointerTilt } from "../scripts/motion";

  const icon = document.querySelector<HTMLElement>("[data-download-icon]");
  const clock = document.querySelector<HTMLElement>("[data-clock-copy]");
  const source = document.querySelector<HTMLElement>("[data-clock]");
  if (clock && source) {
    const copy = (): void => {
      clock.textContent = source.textContent;
    };
    copy();
    setInterval(copy, 15_000);
  }
  pointerTilt((x, y) => {
    if (icon) icon.style.transform = `perspective(800px) rotateY(${(x * 14).toFixed(2)}deg) rotateX(${(-y * 12).toFixed(2)}deg)`;
  });
</script>

<style>
  .download {
    position: relative;
    padding-block: clamp(96px, 12vw, 180px) clamp(80px, 10vw, 140px);
    overflow: clip;
  }

  .download__glow {
    position: absolute;
    left: 50%;
    top: 22%;
    width: 120vmax;
    height: 70vmax;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgb(10 92 255 / 0.28), rgb(16 33 61 / 0.4) 45%, transparent 75%);
    pointer-events: none;
  }

  .download__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 760px;
    height: 48px;
    margin: 0 auto;
    padding: 0 18px;
    border-radius: 14px;
    background: rgb(12 14 20 / 0.6);
    box-shadow: inset 0 0 0 1px var(--line);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    font-family: var(--font-ui);
    font-size: 0.9375rem;
  }

  .download__apps {
    margin-right: auto;
  }

  .download__clock {
    color: rgb(255 255 255 / 0.8);
    white-space: nowrap;
  }

  .download__hero {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 28px;
    margin-top: clamp(48px, 7vw, 96px);
    text-align: center;
  }

  .download__icon {
    width: clamp(140px, 18vw, 240px);
  }

  .download__icon img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 30px 60px rgb(10 92 255 / 0.35));
  }

  :global(.motion) .download__icon {
    animation: icon-float 7s var(--ease-in-out) infinite alternate;
  }

  @keyframes icon-float {
    to {
      translate: 0 -12px;
    }
  }

  .download__title {
    font-size: clamp(3rem, 10vw, 10rem);
  }

  .download__lede {
    max-width: none;
  }

  .download__actions,
  .download__platforms {
    justify-content: center;
  }

  .download__req {
    font-size: 0.8125rem;
    color: var(--text-3);
  }

  .install {
    position: relative;
    display: grid;
    gap: 32px;
    margin-top: clamp(80px, 10vw, 140px);
    padding: clamp(24px, 4vw, 48px);
    border-radius: 24px;
    background: rgb(255 255 255 / 0.025);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .install__intro {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .install h3 {
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 600;
    font-stretch: 85%;
    letter-spacing: -0.03em;
  }

  .install__intro p,
  .install__foot {
    max-width: 68ch;
    color: var(--text-2);
    line-height: 1.6;
  }

  .install__steps {
    display: grid;
    gap: 12px;
  }

  .install__steps li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 14px;
    align-items: start;
    padding: 16px;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.03);
  }

  .install__steps span {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(90 216 255 / 0.5);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--cyan);
  }

  .install__steps p {
    padding-top: 3px;
    color: var(--text-2);
    line-height: 1.55;
  }

  .install__steps strong {
    color: var(--text);
    font-weight: 600;
  }

  .install__foot {
    font-size: 0.9375rem;
  }

  @media (max-width: 559px) {
    .download__clock {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .install {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 56px;
    }

    .install__intro {
      grid-row: span 2;
    }

    .install__foot {
      grid-column: 2;
    }

    .install__steps {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
