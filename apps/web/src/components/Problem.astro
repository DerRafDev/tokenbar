---
// 01. The problem: usage lives in dashboards and terminal commands. While you scroll, the
// windows clear away, the desktop dims, and only the menu bar (with TokenBar in it) remains.
import StatusItem from "./StatusItem.astro";

const windows = [
  { title: "Plan usage — Settings", kind: "bars" },
  { title: "Terminal — /usage", kind: "term" },
  { title: "Account — Limits", kind: "bars" },
  { title: "Terminal — /status", kind: "term" },
  { title: "Billing & usage", kind: "lines" },
];
---

<section id="problem" class="problem" data-problem aria-labelledby="problem-title">
  <div class="problem__stage">
    <div class="wrap problem__grid">
      <div class="problem__copy">
        <p class="index"><b>01</b> The problem</p>
        <h2 id="problem-title" class="headline" data-lines>
          <span class="line"><span>Stop checking</span></span>{" "}
          <span class="line"><span>dashboards.</span></span>
        </h2>
        <ul class="problem__list" role="list">
          <li data-step="0">No dashboard hunting.</li>
          <li data-step="1">No browser tab.</li>
          <li data-step="2">No guessing.</li>
        </ul>
        <p class="body problem__end" data-step="3">
          Your limits stay in the menu bar while you work. TokenBar shows how much of each plan
          limit you have used, and when it resets, without opening a terminal or a website.
        </p>
      </div>

      <div class="desk" aria-hidden="true">
        <div class="desk__screen" data-desk>
          <div class="desk__wall" data-wall></div>
          <div class="desk__windows">
            {
              windows.map((w, i) => (
                <div class={`win win--${i}`} data-win={i}>
                  <div class="win__bar">
                    <i />
                    <i />
                    <i />
                    <span>{w.title}</span>
                  </div>
                  <div class={`win__body win__body--${w.kind}`}>
                    {w.kind === "term" ? (
                      <>
                        <span class="t">›</span>
                        <span class="l" style="--w:62%" />
                        <span class="l" style="--w:44%" />
                        <span class="l" style="--w:78%" />
                        <span class="l" style="--w:36%" />
                        <span class="l" style="--w:54%" />
                      </>
                    ) : (
                      <>
                        <span class="l" style="--w:40%" />
                        <span class="b" style="--w:58%" />
                        <span class="l" style="--w:70%" />
                        <span class="b" style="--w:22%" />
                        <span class="l" style="--w:52%" />
                        {w.kind === "bars" && <span class="b" style="--w:80%" />}
                      </>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
          <div class="desk__menubar" data-desk-bar>
            <span class="desk__apps"><b>Browser</b><span>File</span><span>Edit</span><span>View</span><span>Window</span></span>
            <span class="desk__right">
              <span class="desk__focus" data-desk-focus><StatusItem /></span>
              <span class="desk__clock">9:41 AM</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { scene, seg, easeOut, easeInOut, lerp } from "../scripts/motion";

  const root = document.querySelector<HTMLElement>("[data-problem]");
  if (root && matchMedia("(min-width: 1024px)").matches) {
    const wins = [...root.querySelectorAll<HTMLElement>("[data-win]")];
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")];
    const wall = root.querySelector<HTMLElement>("[data-wall]");
    const bar = root.querySelector<HTMLElement>("[data-desk-bar]");
    const focus = root.querySelector<HTMLElement>("[data-desk-focus]");
    // Direction each window leaves in: [x, y] in percent of its own size.
    const exits = [
      [-70, -40],
      [20, -90],
      [80, 30],
      [-60, 70],
      [90, -50],
    ];

    scene(root, (p) => {
      wins.forEach((w, i) => {
        const t = easeInOut(seg(p, 0.16 + i * 0.07, 0.42 + i * 0.07));
        const [ex, ey] = exits[i]!;
        const drift = Math.sin(p * 6 + i) * 6;
        w.style.transform = `translate3d(${lerp(0, ex!, t)}%, ${lerp(drift, ey!, t)}%, ${lerp(0, 380, t)}px) rotateY(${lerp(-8 + i * 4, i % 2 ? 20 : -20, t)}deg) rotateX(${lerp(4, 12, t)}deg)`;
        w.style.opacity = String(1 - t);
      });

      const dim = easeOut(seg(p, 0.55, 0.75));
      if (wall) wall.style.opacity = String(1 - dim * 0.85);
      const zoom = easeInOut(seg(p, 0.6, 0.86));
      if (bar) bar.style.transform = `scale(${lerp(1, 1.9, zoom).toFixed(3)})`;
      focus?.classList.toggle("is-lit", p > 0.72);

      const thresholds = [0.22, 0.36, 0.5, 0.8];
      steps.forEach((s, i) => s.classList.toggle("is-on", p >= thresholds[i]!));
    });
  }
</script>

<style>
  .problem {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(80px, 12vw, 160px);
  }

  .problem__grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }

  .problem__copy {
    display: grid;
    gap: 28px;
    align-content: center;
  }

  .problem__list {
    display: grid;
    gap: 2px;
    margin-top: 12px;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 500;
    font-stretch: 88%;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .problem__end {
    max-width: 44ch;
  }

  /* ---- desktop illustration ---- */
  .desk {
    perspective: 1200px;
  }

  .desk__screen {
    position: relative;
    aspect-ratio: 16 / 10.5;
    overflow: hidden;
    border-radius: 18px;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 60px 120px -40px rgb(0 0 0 / 0.9);
    background: #04060a;
    font-family: var(--font-ui);
  }

  .desk__wall {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 25% 35%, rgb(10 92 255 / 0.45), transparent 70%),
      radial-gradient(50% 60% at 85% 75%, rgb(90 216 255 / 0.22), transparent 70%),
      linear-gradient(180deg, #0a1730, #050912);
  }

  .desk__windows {
    position: absolute;
    inset: 9% 0 0;
    transform-style: preserve-3d;
  }

  .win {
    position: absolute;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: 10px;
    background: rgb(26 30 40 / 0.94);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 24px 50px -16px rgb(0 0 0 / 0.8);
    will-change: transform, opacity;
  }

  .win--0 { left: 5%; top: 8%; width: 40%; height: 50%; }
  .win--1 { left: 40%; top: 3%; width: 34%; height: 40%; }
  .win--2 { left: 56%; top: 36%; width: 38%; height: 50%; }
  .win--3 { left: 14%; top: 52%; width: 34%; height: 40%; }
  .win--4 { left: 70%; top: 10%; width: 26%; height: 34%; }

  .win__bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 7px 10px;
    background: rgb(255 255 255 / 0.04);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
    font-size: clamp(0.5rem, 0.75vw, 0.6875rem);
    color: rgb(255 255 255 / 0.55);
    white-space: nowrap;
  }

  .win__bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
  }

  .win__bar span {
    margin-left: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .win__body {
    display: grid;
    align-content: start;
    gap: 9%;
    padding: 8% 9%;
  }

  .win__body--term {
    gap: 7%;
    background: rgb(0 0 0 / 0.3);
  }

  .win__body .l,
  .win__body .b {
    display: block;
    width: var(--w);
    height: 6px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.12);
  }

  .win__body .b {
    width: 100%;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.3) var(--w), rgb(255 255 255 / 0.07) var(--w));
  }

  .win__body--term .l {
    background: rgb(110 231 168 / 0.22);
  }

  .win__body .t {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    color: rgb(110 231 168 / 0.7);
  }

  .desk__menubar {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 9%;
    min-height: 22px;
    padding: 0 2.4%;
    background: rgb(12 14 20 / 0.55);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    font-size: clamp(0.5625rem, 0.95vw, 0.8125rem);
    color: #fff;
    transform-origin: 88% 0;
    will-change: transform;
  }

  .desk__apps {
    display: flex;
    gap: 1.4em;
    opacity: 0.85;
  }

  .desk__right {
    display: flex;
    align-items: center;
    gap: 1em;
  }

  .desk__focus {
    position: relative;
    display: inline-flex;
    border-radius: 0.42em;
    transition: box-shadow 0.6s var(--ease-out);
  }

  .desk__focus.is-lit {
    box-shadow:
      0 0 0 1px rgb(90 216 255 / 0.6),
      0 0 24px 2px rgb(90 216 255 / 0.35);
  }

  /* Without motion, show the end state: windows set aside, the menu bar in focus. */
  :global(html:not(.motion)) .win {
    opacity: 0.35;
  }

  @media (max-width: 559px) {
    .desk__apps span {
      display: none;
    }

    .win--4,
    .win--1 {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    :global(.motion) .problem [data-step] {
      opacity: 0.22;
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.8s var(--ease-out);
    }

    :global(.motion) .problem li[data-step] {
      transform: translateX(-10px);
    }

    :global(.motion) .problem [data-step].is-on {
      opacity: 1;
      transform: none;
    }

    :global(.motion) .problem {
      height: 340vh;
      padding: 0;
    }

    :global(.motion) .problem__stage {
      position: sticky;
      top: 0;
      display: flex;
      align-items: center;
      height: 100svh;
      padding-top: var(--bar-h);
    }

    .problem__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(40px, 5vw, 96px);
    }


  }
</style>
