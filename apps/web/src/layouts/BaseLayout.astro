---
import sansUrl from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-normal.woff2?url";
import serifUrl from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Structured data objects, serialized as JSON-LD. */
  schema?: object[];
  noindex?: boolean;
}

const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/index(\.html)?$/, ""), Astro.site);
const ogImage = new URL("/og.png", Astro.site);

// Self-hosted, Latin subset only. The serif is only used in italic, for a few words.
const fontCss = `
@font-face{font-family:"Instrument Sans";font-style:normal;font-display:swap;font-weight:400 700;font-stretch:75% 100%;src:url(${sansUrl}) format("woff2-variations"),url(${sansUrl}) format("woff2")}
@font-face{font-family:"Instrument Serif";font-style:italic;font-display:swap;font-weight:400;src:url(${serifUrl}) format("woff2")}`;

// Runs before first paint: `js` turns on enhanced layouts, `motion` turns on animation.
// Without JavaScript, or with Reduce Motion, the page is a static, complete document.
const boot = `(function(){var d=document.documentElement,m=matchMedia("(prefers-reduced-motion: reduce)");d.classList.add("js");function s(){d.classList.toggle("motion",!m.matches)}s();m.addEventListener&&m.addEventListener("change",function(){location.reload()})})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050609" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/markdown" href="/llms.md" title="TokenBar for language models" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TokenBar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TokenBar: your AI usage limits in the macOS menu bar" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss} />
    <script is:inline set:html={boot} />
    {schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
